# ============================================================
# OKX Demo Trading 配置 - SOL/USDT 测试
# ============================================================
# 使用说明：
# 1. 将此文件内容复制到 .env（或创建新的 .env）
# 2. 替换 your_demo_* 为你的真实 OKX Demo Trading 凭据
# 3. 运行：bash scripts/test_sol_demo.sh
# ============================================================

# ------------------------------------------------------------
# OKX Demo Trading API 凭据
# ------------------------------------------------------------
# 获取方式：https://www.okx.com → API 管理 → 创建 Demo Trading API Key
OKX_API_KEY=your_demo_api_key_here
OKX_API_SECRET=your_demo_api_secret_here
OKX_PASSPHRASE=your_demo_passphrase_here
OKX_ENV=testnet

# ------------------------------------------------------------
# TradingView Webhook 基础配置
# ------------------------------------------------------------
PERPBOT_TV_ENABLED=true
PERPBOT_TV_WEBHOOK_SECRET=CHANGE_ME
PERPBOT_TV_DEFAULT_EXCHANGE=okx

# ------------------------------------------------------------
# 实盘下单开关（重要！）
# ------------------------------------------------------------
PERPBOT_TV_TRADING_ENABLED=true          # true=实盘下单, false=paper模式

# ------------------------------------------------------------
# 双向持仓 + 止损单
# ------------------------------------------------------------
PERPBOT_TV_HEDGE_MODE=true               # 双向持仓（需在OKX账户设置中开启）
PERPBOT_TV_PLACE_STOP_LOSS=true          # 自动挂止损单

# ------------------------------------------------------------
# SOL 交易配置
# ------------------------------------------------------------
PERPBOT_TV_ALLOW_ALL_SYMBOLS=true        # 允许所有交易对
PERPBOT_TV_ORDER_SIZE=0.1                # 默认 0.1 SOL（可按需调整）

# 可选：指定允许的交易对白名单
# PERPBOT_TV_SYMBOL_ALLOWLIST=SOL/USDT,ETH/USDT,BTC/USDT

# ------------------------------------------------------------
# 止损/止盈参数
# ------------------------------------------------------------
PERPBOT_TV_STOP_METHOD=lookback          # lookback | pivot
PERPBOT_TV_STOP_LOOKBACK_BARS=50         # 回看 K 线数量
PERPBOT_TV_TP_RR=3.0                     # 盈亏比（Risk:Reward）
PERPBOT_TV_ATR_LEN=14
PERPBOT_TV_ATR_BUFFER_MULT=0.2
PERPBOT_TV_MIN_BUFFER_BPS=3

# ------------------------------------------------------------
# 其他可选配置
# ------------------------------------------------------------
PERPBOT_TV_ZONE_TTL_SECONDS=900
PERPBOT_TV_COOLDOWN_SECONDS=120
PERPBOT_TV_ENABLE_LONG=true
PERPBOT_TV_ENABLE_SHORT=true
PERPBOT_TV_MARKETS_CACHE_SEC=600
