# ============================================================
# Perp-Tools 交易机器人配置文件
# ============================================================
#
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 填写你的 API 凭证
# 3. 选择要启用的交易所（删除不用的配置）
#
# ⚠️ 警告：不要提交 .env 文件到 Git！
# ============================================================

# ------------------------------------------------------------
# OKX 交易所配置（CEX - Demo Trading）
# ------------------------------------------------------------
# 获取方式：https://www.okx.com/account/my-api
#
# 重要：OKX 强制使用 Demo Trading 模式（x-simulated-trading: 1）
# 这是测试账户，不会影响真实资金

OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_ENV=testnet

# ------------------------------------------------------------
# Paradex 交易所配置（DEX - Starknet）
# ------------------------------------------------------------
# 使用 Paradex SDK + L2 私钥（不再使用 API Key）
#
# 获取方式：
# 1. L2 私钥：从你的 Starknet 钱包（Argent X / Braavos）导出
# 2. 账户地址：你的 Starknet 钱包地址
#
# ⚠️ 重要：L2 私钥是真实资金的密钥，请妥善保管！

PARADEX_L2_PRIVATE_KEY=0xyour_l2_private_key_here
PARADEX_ACCOUNT_ADDRESS=0xYourStarknetWalletAddress
PARADEX_ENV=testnet

# ------------------------------------------------------------
# EdgeX 交易所配置（DEX）
# ------------------------------------------------------------
# 获取方式：https://app.edgex.exchange/

# EDGEX_API_KEY=your_edgex_api_key_here
# EDGEX_API_SECRET=your_edgex_api_secret_here
# EDGEX_ENV=testnet

# ------------------------------------------------------------
# Backpack 交易所配置（DEX）
# ------------------------------------------------------------
# 获取方式：https://backpack.exchange/

# BACKPACK_API_KEY=your_backpack_api_key_here
# BACKPACK_API_SECRET=your_backpack_api_secret_here
# BACKPACK_ENV=testnet

# ------------------------------------------------------------
# Aster 交易所配置（DEX）
# ------------------------------------------------------------
# 获取方式：https://app.aster.com/

# ASTER_API_KEY=your_aster_api_key_here
# ASTER_API_SECRET=your_aster_api_secret_here
# ASTER_ENV=testnet

# ------------------------------------------------------------
# GRVT 交易所配置（DEX）
# ------------------------------------------------------------
# 获取方式：https://app.grvt.io/

# GRVT_API_KEY=your_grvt_api_key_here
# GRVT_API_SECRET=your_grvt_api_secret_here
# GRVT_ENV=testnet

# ------------------------------------------------------------
# Extended 交易所配置（DEX - Starknet）
# ------------------------------------------------------------
# 获取方式：https://app.extended.exchange/api-management

# EXTENDED_API_KEY=your_extended_api_key_here
# EXTENDED_STARK_PRIVATE_KEY=0x...your_stark_private_key_here
# EXTENDED_VAULT_NUMBER=123456            # 必填：Extended 控制台 Vault/Collateral ID
# EXTENDED_ENV=mainnet
#
# 可选：Extended WS 调参（用于定位频繁 1006 断线）
# - 禁用订单簿 WS：强制走 REST snapshot（更稳定，但实时性差）
# EXTENDED_DISABLE_ORDERBOOK_WS=1
# - 禁用账户 WS：只用 REST 拉余额/持仓（更少 WS 干扰）
# EXTENDED_DISABLE_ACCOUNT_WS=1
# - 订单簿缓存陈旧阈值：超过就不信缓存，自动走 snapshot 刷新（默认 30 秒；0 表示不做陈旧判断）
# EXTENDED_ORDERBOOK_STALE_SEC=30

# ------------------------------------------------------------
# Lighter 交易所配置（DEX - Ethereum L2）
# ------------------------------------------------------------
# 获取方式：https://app.lighter.xyz/
# SDK: pip install -r requirements/lighter.txt
#
# ✅ 推荐配置（三件套，兼容 perp-tools 当前实现）：
# - LIGHTER_API_KEY_PRIVATE_KEY: Lighter 前端生成的 API Key 私钥（0x 前缀）
# - LIGHTER_ACCOUNT_INDEX: 账户 index（十进制，通常为正整数）
# - LIGHTER_API_KEY_INDEX: API Key index（十进制，常见 0/1/2）
#
# 兼容旧命名（不推荐）：LIGHTER_PRIVATE_KEY 也会被当作 API_KEY_PRIVATE_KEY 使用。

# LIGHTER_API_KEY_PRIVATE_KEY=0x...your_lighter_api_key_private_key_here
# LIGHTER_ACCOUNT_INDEX=1
# LIGHTER_API_KEY_INDEX=0
# LIGHTER_PRIVATE_KEY=0x...legacy_alias_do_not_use

# LIGHTER_ENV=mainnet
# LIGHTER_API_BASE_URL=https://mainnet.zklighter.elliot.ai  # 可选：覆盖默认 API Host
# LIGHTER_ORDERBOOK_CACHE_MS=250                             # 可选：降低 429（默认 250ms）

# ------------------------------------------------------------
# Binance USDT-M Futures 配置（CEX - Testnet）
# ------------------------------------------------------------
# 获取方式：
# 1. 主网：https://www.binance.com/en/account/api-management
# 2. Testnet：https://testnet.binancefuture.com
#
# 重要：使用 Testnet 进行测试（无真实资金风险）
# Testnet 文档：https://binance-docs.github.io/apidocs/testnet/cn/

BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_ENV=testnet

# ------------------------------------------------------------
# Hyperliquid 配置（DEX - Testnet 支持）
# ------------------------------------------------------------
# 获取方式：
# 1. 主网：https://app.hyperliquid.xyz
# 2. Testnet：https://testnet.hyperliquid.xyz
#
# 凭证为可选（支持读-only 模式）
# - 账户地址：Hyperliquid 账户地址
# - 私钥：对应的 EVM 私钥（可选，不输入只能读数据）

HYPERLIQUID_ACCOUNT_ADDRESS=0xyour_account_address_here
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_ENV=testnet

# ------------------------------------------------------------
# BITGET 配置（CEX - Testnet）
# ------------------------------------------------------------
# 获取方式：https://www.bitget.com/en/user/account/api-management
#
# BITGET 同时支持现货和永续期货交易
# 推荐使用 Testnet 进行测试

BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here
BITGET_ENV=testnet

# ------------------------------------------------------------
# Bybit 配置（CEX - 主网小额测试）
# ------------------------------------------------------------
# 获取方式：https://www.bybit.com/en/user/api-management
# 依赖：pip install -r requirements/bybit.txt

BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_ENV=mainnet

# ============================================================
# 配置说明
# ============================================================
#
# ENV 环境选择：
# - testnet: 测试网（推荐新手，无真实资金风险）
# - mainnet: 主网（真实交易，需谨慎）
#
# 如何获取 API 凭证：
# 1. 注册交易所账户
# 2. 完成 KYC（如需要）
# 3. 进入账户设置 → API 管理
# 4. 创建新的 API Key
# 5. 复制 API Key 和 Secret（仅显示一次）
# 6. 设置 API 权限（建议只开启必需权限）
#
# 安全建议：
# - ✅ 使用只读 API Key 测试连接
# - ✅ 为 API Key 设置 IP 白名单
# - ✅ 定期更换 API Key
# - ✅ 不要在代码中硬编码凭证
# - ❌ 不要分享 API Secret
# - ❌ 不要提交 .env 到 Git
#

# ============================================================
# 诊断 / 稳定性调参（问题暴露优先）
# ============================================================
#
# 说明：
# - 默认会对部分“明显是抖动/限流”的 HTTP 错误做少量重试，并输出 warning 日志
# - 如果你想“最快暴露问题”，把重试次数调成 1（等于禁用重试）
#
# HTTP 重试（影响 `src/perpbot/exchanges/base.py` 的通用 REST 客户端）
# PERPBOT_HTTP_RETRY_ATTEMPTS=1
# PERPBOT_HTTP_RETRY_MIN_DELAY_SEC=0.25
# PERPBOT_HTTP_RETRY_MAX_DELAY_SEC=2.0
# PERPBOT_HTTP_RETRY_JITTER_SEC=0.25
# PERPBOT_HTTP_RETRY_STATUS_CODES=429,500,502,503,504
#
# 行情 WS 健康检测（影响 `src/perpbot/exchanges/websocket_manager.py`）
# - 超过多少秒没有收到有效更新就强制断线重连（0 表示关闭）
# PERPBOT_WS_STALE_SEC=60
# PERPBOT_WS_RECONNECT_BACKOFF_MAX_SEC=60
# PERPBOT_WS_RECONNECT_JITTER_SEC=0.5
#
# 线级别日志（websockets/httpx/httpcore）默认会压到 WARNING
# - 需要抓包式 debug 再打开
# PERPBOT_VERBOSE_WIRE_LOGS=1
