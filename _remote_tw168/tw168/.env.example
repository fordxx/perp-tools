TV_WEBHOOK_SECRET=CHANGE_ME
EXCHANGE=okx

# Telegram notifications (optional)
# Get bot token from @BotFather on Telegram
# Get chat ID from @userinfobot or use group ID (negative number)
# See TELEGRAM_SETUP.md for detailed instructions
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OKX
OKX_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_TD_MODE=cross
TRADING_ENABLED=false

# Paper collection mode: if a signal timeframe is listed here, the webhook will NOT place orders.
# It still records the signal + derived prices (1m ref, SL, recommended 2-limit entries) to the audit log.
PAPER_TRADE_TFS=

# Paradex (DEX)
PARADEX_ENV=prod
PARADEX_L2_PRIVATE_KEY=
PARADEX_ACCOUNT_ADDRESS=

# Trading / risk
SYMBOL_ALLOWLIST=ETH-USDT-SWAP
ZONE_TTL_SECONDS=900
COOLDOWN_SECONDS=120
DEDUPE_TTL_SECONDS=1800
HEALTH_LOG_SECONDS=60
ENABLE_LONG=true
ENABLE_SHORT=true

# Persist TradingView signals/decisions to JSONL files (daily) under SIGNAL_AUDIT_DIR.
# Note: payload.secret is never written.
SIGNAL_AUDIT_ENABLED=true
SIGNAL_AUDIT_DIR=/app/logs

# Order type: market | limit
ORDER_TYPE=market
LIMIT_SLIPPAGE_BPS=5

# Fixed size (contracts). Use RISK_PER_TRADE_USDT instead for consistent risk!
ORDER_SZ=1

# Risk-based position sizing (RECOMMENDED)
# Set to 0 to use fixed ORDER_SZ (NOT recommended due to inconsistent risk)
RISK_PER_TRADE_USDT=0

# Two-limit entry mode (pure limit orders, prices derived from stop-loss distance)
# Reference price is taken from 1m candles by default.
# For long (buy): P1 = P0 - L1_R*(P0-SL), P2 = P0 - L2_R*(P0-SL)
# For short (sell): mirrored upwards.
ENTRY_TWO_LIMIT_ENABLED=false
ENTRY_TWO_LIMIT_REF_BAR=1m
ENTRY_TWO_LIMIT_L1_R=0.25
ENTRY_TWO_LIMIT_L2_R=0.65
ENTRY_TWO_LIMIT_L1_PCT=0.70
ENTRY_TWO_LIMIT_L2_PCT=0.30
# Cancel unfilled entry orders after N candles of the signal TF (set <=0 to disable).
ENTRY_TWO_LIMIT_TIMEOUT_CANDLES=1.0
# Override timeout per timeframe (optional), e.g. "30m:2,1h:1.5,4h:1"
ENTRY_TWO_LIMIT_TIMEOUT_CANDLES_BY_TF=
ENTRY_TWO_LIMIT_POLL_SECONDS=2.0

# Stop-loss computation
PIVOT_LEN=3
ATR_LEN=14
ATR_BUFFER_MULT=0.2
MIN_BUFFER_BPS=3
STOP_METHOD=lookback
STOP_LOOKBACK_BARS=50

# Pattern filters (optional)
PATTERN_LONG=none
PATTERN_SHORT=none
PATTERN_PIVOT_LEN=3
PATTERN_TOL_PCT=0.004
W_MIN_BOUNCE_PCT=0.003
W_REQUIRE_BREAKOUT=false
HS_MIN_SHOULDER_DROP_PCT=0.003
HS_REQUIRE_BREAKDOWN=false

# Take-profit ladder (R-multiples of stop distance)
# NOTE: TP1_PCT + TP2_PCT + TP3_PCT + TP4_PCT should equal 1.0 (100%)
TP_ENABLED=true
TP1_R=1.5
TP1_PCT=0.70
TP2_R=2.0
TP2_PCT=0.15
TP3_R=2.5
TP3_PCT=0.10
TP4_R=3.5
TP4_PCT=0.05
TRAIL_START_R=0.8
TRAIL_BACK_R=0.75
MANAGER_POLL_SECONDS=2

# RSI-only mode: allow DIV to decide zone without ZONE signals
RSI_ALLOW_NO_ZONE=true
RSI_FILTER_ENABLED=false
RSI_DEBUG=false
RSI_USE_LIVE_CANDLE=true
RSI_THRESHOLD_MODE=kmeans
RSI_SMOOTH=true
RSI_SMOOTH_PERIOD=4
RSI_MA_TYPE=ema
RSI_PCT_LOW=25
RSI_PCT_HIGH=75
# Optional per-timeframe overrides (e.g. "1h:24/72,4h:28/78")
RSI_PCT_BY_TF=
# Optional per-symbol overrides (e.g. "BTC-USDT-SWAP@4h:30/76,ETH-USDT-SWAP:28/78")
RSI_PCT_BY_SYMBOL=
RSI_MAX_DATA=3000
# Optional per-timeframe overrides (e.g. "1h:2000,4h:1500")
RSI_MAX_DATA_BY_TF=
# Optional per-symbol overrides (e.g. "BTC-USDT-SWAP@4h:500,ETH-USDT-SWAP:1000")
RSI_MAX_DATA_BY_SYMBOL=
RSI_MAX_ITER=1000

# Candle WebSocket cache
CANDLE_WS_ENABLED=true
CANDLE_WS_OKX_ENABLED=true
CANDLE_WS_EXTENDED_ENABLED=true
CANDLE_WS_TFS=1h
CANDLE_CACHE_TTL_SECONDS=30
CANDLE_CACHE_MAX_BARS=4000
CANDLE_WS_OKX_MAX_SUBS=200
CANDLE_WS_EXTENDED_MAX_SUBS=50
CANDLE_WS_EXTENDED_IDLE_SECONDS=600
# If set, this list is treated as the allowlist (symbols not listed are rejected).
# You can omit TF to use default CANDLE_WS_TFS (1h).
CANDLE_WS_SYMBOL_TFS=
# Optional file with per-symbol TFs (one per line):
# ETH-USDT-SWAP: 1m,15m
# BTC-USDT-SWAP: 5m|1h
CANDLE_WS_SYMBOL_TFS_FILE=
# If true, only allow subscriptions listed in CANDLE_WS_SYMBOL_TFS or file.
CANDLE_WS_SYMBOL_TFS_STRICT=false
EXTENDED_REFRESH_SECONDS=300
EXTENDED_REFRESH_ENABLED=true
EXTENDED_REFRESH_SL_ENABLED=true
EXTENDED_REFRESH_TP_ENABLED=true
# Extended order expiration in hours (GTT), default 168h (7 days)
EXTENDED_ORDER_EXPIRE_HOURS=168
